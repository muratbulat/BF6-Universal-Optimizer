<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:BF6Optimizer.App.ViewModels"
                    xmlns:c="clr-namespace:BF6Optimizer.App.Controls"
                    xmlns:loc="clr-namespace:BF6Optimizer.App.Localization">

    <DataTemplate x:Key="ScanButtons">
        <WrapPanel Margin="0,0,0,8">
            <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr ui.quick_scan}" Command="{Binding QuickScanCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ui.quick_scan" />
            <ui:Button Content="{loc:Tr ui.full_scan}" Command="{Binding FullScanCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ui.full_scan" />
            <ui:Button Content="HTML" Command="{Binding ExportCommand}" CommandParameter="html" Margin="0,0,4,0" AutomationProperties.AutomationId="export.HTML" />
            <ui:Button Content="JSON" Command="{Binding ExportCommand}" CommandParameter="json" Margin="0,0,4,0" AutomationProperties.AutomationId="export.JSON" />
            <ui:Button Content="TXT" Command="{Binding ExportCommand}" CommandParameter="txt" AutomationProperties.AutomationId="export.TXT" />
        </WrapPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <Grid Style="{StaticResource PageRoot}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr nav.dashboard}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding LastScan}" Style="{StaticResource PageSubtitle}" AutomationProperties.AutomationId="dash.last_scan" />

                    <WrapPanel Margin="0,0,0,2">
                        <ui:Button Style="{StaticResource PrimaryButton}" Icon="{ui:SymbolIcon ScanDash24}" Content="{loc:Tr ui.scan_system}" Command="{Binding FullScanCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="dash.scan" />
                        <ui:Button Content="{loc:Tr ui.quick_scan}" Command="{Binding QuickScanCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="dash.quick" />
                        <ui:Button Icon="{ui:SymbolIcon Games24}" Content="{loc:Tr ui.optimize_bf6}" Command="{Binding OpenOptimizerCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="dash.optimize" />
                        <ui:Button Icon="{ui:SymbolIcon Globe24}" Content="{loc:Tr ui.network_test}" Command="{Binding OpenServersCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="dash.network" />
                        <ui:Button Icon="{ui:SymbolIcon HeartPulse24}" Content="{loc:Tr ui.view_recs}" Command="{Binding OpenHealthCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="dash.recs" />
                        <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" Content="{loc:Tr ui.export_report}" Command="{Binding ExportCommand}" CommandParameter="html" Margin="0,0,6,6" AutomationProperties.AutomationId="dash.export" />
                    </WrapPanel>

                    <TextBlock Text="{loc:Tr ui.readiness}" Style="{StaticResource SectionHeader}" />
                    <c:ResponsiveGrid MinItemWidth="170" MaxColumns="5">
                        <Border Style="{StaticResource GridCard}" ToolTip="{loc:Tr report.score_note}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr ui.health_score}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Score}" Style="{StaticResource BigValue}" Foreground="{DynamicResource Accent}" AutomationProperties.AutomationId="dash.score" />
                                <ProgressBar Value="{Binding ScoreValue}" Maximum="100" Height="3" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GridCard}" ToolTip="{loc:Tr ui.coverage_note}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr ui.coverage}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Coverage}" Style="{StaticResource BigValue}" AutomationProperties.AutomationId="dash.coverage" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GridCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr ui.critical_count}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource BigValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GridCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr ui.high_count}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding HighCount}" Style="{StaticResource BigValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GridCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr ui.opportunity_count}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding OpportunityCount}" Style="{StaticResource BigValue}" />
                            </StackPanel>
                        </Border>
                    </c:ResponsiveGrid>

                    <TextBlock Text="{loc:Tr ui.hardware_overview}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource InfoCard}" ItemsPanel="{StaticResource CardPanel}" Focusable="False" />

                    <TextBlock Text="{loc:Tr ui.category_scores}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Categories}" ItemsPanel="{StaticResource SmallCardPanel}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GridCard}" Padding="10,6" ToolTip="{Binding Note}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,26,0" />
                                            <TextBlock Text="{Binding Score}" Style="{StaticResource Body}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{Binding Value}" Maximum="100" Height="3" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:Tr ui.top_recommendations}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Top}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />
                    <TextBlock Text="{loc:Tr ui.no_recs}" Style="{StaticResource Muted}" Margin="0,0,0,8" Visibility="{Binding HasTop, Converter={StaticResource NotBoolToVis}}" AutomationProperties.AutomationId="dash.no_recs" />
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr ui.bf6_last}" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Bf6Status}" Style="{StaticResource Body}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

<DataTemplate DataType="{x:Type vm:HealthViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <Grid Style="{StaticResource PageRoot}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr nav.health}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
                    <ContentPresenter ContentTemplate="{StaticResource ScanButtons}" Content="{Binding}" />
                    <ComboBox ItemsSource="{Binding Filters}" SelectedIndex="{Binding FilterIndex}" MinWidth="280" HorizontalAlignment="Left" Margin="0,0,0,10" AutomationProperties.AutomationId="field.Filters" />
                    <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckRow}" />
                    <TextBlock Text="{loc:Tr ui.glossary}" Style="{StaticResource Section}" Margin="0,12,0,8" />
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Glossary}" ItemTemplate="{StaticResource FactRow}" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DisplayTools}">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{loc:Tr ui.gaming_display}" Style="{StaticResource Section}" />
                <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding Selected}" DisplayMemberPath="FriendlyName" MinWidth="340" HorizontalAlignment="Left" AutomationProperties.AutomationId="field.Displays" />
                <TextBlock Text="{Binding CapText}" Style="{StaticResource Muted}" Margin="0,8,0,8" />
                <WrapPanel>
                    <ui:Button Content="{loc:Tr ui.open_display_settings}" Command="{Binding OpenDisplaySettingsCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ui.open_display_settings" />
                    <ui:Button Content="{loc:Tr ui.open_graphics_settings}" Command="{Binding OpenGraphicsSettingsCommand}" AutomationProperties.AutomationId="ui.open_graphics_settings" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NetworkTools}">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{loc:Tr ui.net_test}" Style="{StaticResource Section}" />
                <TextBlock Text="{loc:Tr ui.net_test_note}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                <WrapPanel>
                    <ui:TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" MinWidth="280" Margin="0,0,8,0" AutomationProperties.AutomationId="field.Target" />
                    <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr ui.run_test}" Command="{Binding ProbeCommand}" AutomationProperties.AutomationId="ui.run_test" />
                </WrapPanel>
                <TextBlock Text="{Binding Result}" Style="{StaticResource Body}" Margin="0,8,0,0" AutomationProperties.AutomationId="probe.result" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AnalyzerViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <Grid Style="{StaticResource PageRoot}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                    <ContentPresenter ContentTemplate="{StaticResource ScanButtons}" Content="{Binding}" />
                    <TextBlock Text="{loc:Tr ui.no_audit}" Style="{StaticResource Muted}" Visibility="{Binding HasAudit, Converter={StaticResource NotBoolToVis}}" Margin="0,0,0,10" />
                    <ContentPresenter Content="{Binding Tools}" Visibility="{Binding Tools, Converter={StaticResource NullToVis}}" />
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasAudit, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactRow}" />
                    </Border>
                    <TextBlock Text="{loc:Tr ui.findings}" Style="{StaticResource Section}" Margin="0,6,0,8" />
                    <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckRow}" />
                    <StackPanel Visibility="{Binding HasList, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ListTitle}" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource Card}">
                            <ItemsControl ItemsSource="{Binding List}" ItemTemplate="{StaticResource FactRow}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <Grid Style="{StaticResource PageRoot}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr nav.hardware}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{loc:Tr sub.hardware}" Style="{StaticResource PageSubtitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Content="{loc:Tr ui.rescan}" Command="{Binding RescanCommand}" AutomationProperties.AutomationId="ui.rescan" />
                        <TextBlock Text="{Binding RescanResult}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="12,0,0,0" AutomationProperties.AutomationId="hardware.result" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr ui.gaming_gpu}" Style="{StaticResource Section}" />
                            <ComboBox ItemsSource="{Binding Gpus}" SelectedItem="{Binding SelectedGpu}" DisplayMemberPath="Name" MinWidth="420" HorizontalAlignment="Left" Margin="0,0,0,10" AutomationProperties.AutomationId="field.Gpus" />
                            <TextBlock Text="{loc:Tr ui.gaming_display}" Style="{StaticResource Section}" />
                            <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}" DisplayMemberPath="FriendlyName" MinWidth="420" HorizontalAlignment="Left" AutomationProperties.AutomationId="field.Displays" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactRow}" />
                    </Border>
                    <TextBlock Text="{Binding HagsNote}" Style="{StaticResource Muted}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="MetricCard">
        <Border Style="{StaticResource GridCard}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Current}" Style="{StaticResource Body}" HorizontalAlignment="Right" />
                </Grid>
                <c:LineChart Values="{Binding Values}" Maximum="{Binding Maximum}" Height="56" Margin="0,6,0,0" Stroke="{DynamicResource Accent}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <Grid Style="{StaticResource PageRoot}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr nav.monitor}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{loc:Tr sub.monitor}" Style="{StaticResource PageSubtitle}" />
                    <WrapPanel Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding Intervals}" SelectedIndex="{Binding IntervalIndex}" MinWidth="110" Margin="0,0,8,0" AutomationProperties.AutomationId="field.Intervals" />
                        <ComboBox ItemsSource="{Binding Durations}" SelectedIndex="{Binding DurationIndex}" MinWidth="190" Margin="0,0,8,0" AutomationProperties.AutomationId="field.Durations" />
                        <ui:TextBox Text="{Binding CustomSeconds}" MinWidth="90" Margin="0,0,8,0" ToolTip="{loc:Tr ui.custom_seconds}" AutomationProperties.AutomationId="field.CustomSeconds" />
                        <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr ui.start}" Command="{Binding StartCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ui.start" />
                        <ui:Button Content="{loc:Tr ui.stop}" Command="{Binding StopCommand}" AutomationProperties.AutomationId="ui.stop" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Extra}" Style="{StaticResource Body}" Margin="0,0,0,10" AutomationProperties.AutomationId="monitor.extra" />
                    <c:ResponsiveGrid MinItemWidth="280" MaxColumns="3">
                        <ContentPresenter Content="{Binding Cpu}" ContentTemplate="{StaticResource MetricCard}" />
                        <ContentPresenter Content="{Binding Gpu}" ContentTemplate="{StaticResource MetricCard}" />
                        <ContentPresenter Content="{Binding Ram}" ContentTemplate="{StaticResource MetricCard}" />
                        <ContentPresenter Content="{Binding Disk}" ContentTemplate="{StaticResource MetricCard}" />
                        <ContentPresenter Content="{Binding Net}" ContentTemplate="{StaticResource MetricCard}" />
                    </c:ResponsiveGrid>
                    <TextBlock Text="{loc:Tr ui.per_core}" Style="{StaticResource Section}" />
                    <ItemsControl ItemsSource="{Binding Cores}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="64" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" />
                                    <ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <Grid Style="{StaticResource PageRoot}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr nav.sessions}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{loc:Tr sub.sessions}" Style="{StaticResource PageSubtitle}" />
                    <WrapPanel Margin="0,0,0,8">
                        <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr ui.start_session}" Command="{Binding StartCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ui.start_session" />
                        <ui:Button Content="{loc:Tr ui.end_session}" Command="{Binding StopCommand}" AutomationProperties.AutomationId="ui.end_session" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Phase}" Style="{StaticResource Body}" Margin="0,0,0,10" AutomationProperties.AutomationId="session.phase" />
                    <c:ResponsiveGrid MinItemWidth="280" MaxColumns="3">
                        <ContentPresenter Content="{Binding Cpu}" ContentTemplate="{StaticResource MetricCard}" />
                        <ContentPresenter Content="{Binding Gpu}" ContentTemplate="{StaticResource MetricCard}" />
                    </c:ResponsiveGrid>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource FactRow}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,0,0,4" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <Grid Style="{StaticResource PageRoot}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr nav.processes}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Assessment}" Style="{StaticResource PageSubtitle}" />
                    <WrapPanel Margin="0,0,0,8">
                        <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr ui.refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ui.refresh" />
                        <ComboBox ItemsSource="{Binding Sorts}" SelectedIndex="{Binding SortIndex}" MinWidth="200" AutomationProperties.AutomationId="field.Sorts" />
                    </WrapPanel>
                    <Border Style="{StaticResource Card}">
                        <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding Processes}" FrozenColumnCount="1" AutomationProperties.AutomationId="proc.grid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr proc.name}" Binding="{Binding Name}" Width="*" MinWidth="150" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="64" />
                                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" SortMemberPath="CpuValue" Width="70" />
                                <DataGridTextColumn Header="{loc:Tr ui.ram}" Binding="{Binding Memory}" SortMemberPath="MemoryValue" Width="86" />
                                <DataGridTextColumn Header="{loc:Tr proc.private}" Binding="{Binding Private}" Width="86" />
                                <DataGridTextColumn Header="Disk" Binding="{Binding Disk}" SortMemberPath="DiskValue" Width="86" />
                                <DataGridTextColumn Header="{loc:Tr ui.manufacturer}" Binding="{Binding Publisher}" Width="*" MinWidth="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Text="{loc:Tr ui.startup_apps}" Style="{StaticResource Section}" Margin="0,8,0,4" />
                    <TextBlock Text="{loc:Tr ui.startup_note}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                    <ui:Button Content="{loc:Tr ui.open_startup}" Command="{Binding OpenStartupSettingsCommand}" Margin="0,0,0,8" AutomationProperties.AutomationId="ui.open_startup" />
                    <Border Style="{StaticResource Card}">
                        <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding Startup}" RowHeight="34" AutomationProperties.AutomationId="startup.grid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr proc.name}" Binding="{Binding Name}" Width="*" MinWidth="150" />
                                <DataGridTextColumn Header="{loc:Tr net.ep.category}" Binding="{Binding Category}" Width="Auto" MinWidth="120" />
                                <DataGridTextColumn Header="{loc:Tr net.col.source}" Binding="{Binding Location}" Width="Auto" MinWidth="100" />
                                <DataGridTextColumn Header="{loc:Tr ui.status}" Binding="{Binding State}" Width="Auto" MinWidth="70" />
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content="{loc:Tr ui.locate}" MinHeight="26" Padding="8,1" Margin="0,0,4,0" CommandParameter="{Binding}" AutomationProperties.AutomationId="startup.locate"
                                                           Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                <ui:Button Content="{Binding ToggleText}" MinHeight="26" Padding="8,1" Command="{Binding ToggleCommand}" AutomationProperties.AutomationId="startup.toggle" Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SafeCenterViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <Grid Style="{StaticResource PageRoot}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr nav.safe}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{loc:Tr sub.safe}" Style="{StaticResource PageSubtitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr safe.a}" Style="{StaticResource Body}" Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Tr safe.b}" Style="{StaticResource Body}" Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Tr safe.c}" Style="{StaticResource Body}" Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Tr safe.d}" Style="{StaticResource Body}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{loc:Tr ui.safe_prefs}" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Before}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="2" Text="{Binding After}" Style="{StaticResource Body}" Foreground="{DynamicResource Accent}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Scope}" Style="{StaticResource Muted}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <WrapPanel Margin="0,0,0,8">
                        <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr ui.safe_apply}" Command="{Binding ApplyCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ui.safe_apply" />
                        <ui:Button Content="{loc:Tr ui.safe_restore}" Command="{Binding RestoreCommand}" AutomationProperties.AutomationId="ui.safe_restore" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" AutomationProperties.AutomationId="safe.message" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
