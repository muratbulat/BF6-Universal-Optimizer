<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:BF6Optimizer.App.ViewModels"
                    xmlns:c="clr-namespace:BF6Optimizer.App.Controls"
                    xmlns:loc="clr-namespace:BF6Optimizer.App.Localization">

    <DataTemplate DataType="{x:Type vm:Bf6ServersViewModel}">
        <Grid Style="{StaticResource PageRoot}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:Tr nav.servers}" Style="{StaticResource PageTitle}" />
            <TextBlock Grid.Row="1" Text="{loc:Tr sub.servers}" Style="{StaticResource PageSubtitle}" />
            <TabControl Grid.Row="2" AutomationProperties.AutomationId="servers.tabs">
                <TabItem Header="{loc:Tr net.tab.regions}" AutomationProperties.AutomationId="tab.regions">
                    <ScrollViewer Style="{StaticResource PageScroll}">
                        <StackPanel Margin="0,8,8,8">
                            <Border Style="{StaticResource Card}">
                                <ItemsControl ItemsSource="{Binding Connection}" ItemTemplate="{StaticResource FactRow}" />
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,8,6">
                                            <TextBlock Text="{loc:Tr net.preset}" Style="{StaticResource Muted}" />
                                            <ComboBox ItemsSource="{Binding PresetNames}" SelectedIndex="{Binding PresetIndex}" MinWidth="150" AutomationProperties.AutomationId="net.preset" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,6">
                                            <TextBlock Text="{loc:Tr net.protocol}" Style="{StaticResource Muted}" />
                                            <ComboBox ItemsSource="{Binding Protocols}" SelectedIndex="{Binding ProtocolIndex}" MinWidth="170" AutomationProperties.AutomationId="net.protocol" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,6">
                                            <TextBlock Text="{loc:Tr net.samples}" Style="{StaticResource Muted}" />
                                            <ComboBox ItemsSource="{Binding SampleNames}" SelectedIndex="{Binding SamplesIndex}" MinWidth="70" AutomationProperties.AutomationId="net.samples" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,6">
                                            <TextBlock Text="{loc:Tr net.search}" Style="{StaticResource Muted}" />
                                            <ui:TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MinWidth="150" AutomationProperties.AutomationId="net.search" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr net.test_all}" Command="{Binding TestAllCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="net.test_all" />
                                        <ui:Button Content="{loc:Tr net.test_selected}" Command="{Binding TestSelectedCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="net.test_selected" />
                                        <ui:Button Content="{loc:Tr net.stop}" Command="{Binding StopTestCommand}" IsEnabled="{Binding IsTesting}" Margin="0,0,6,6" AutomationProperties.AutomationId="net.stop" />
                                        <ui:Button Content="{loc:Tr net.refresh_targets}" Command="{Binding RefreshTargetsCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="net.refresh_targets" />
                                        <ui:Button Content="{loc:Tr net.export}" Command="{Binding ExportResultsCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="net.export" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Progress}" Style="{StaticResource Body}" AutomationProperties.AutomationId="net.progress" />
                                    <TextBlock Text="{Binding TargetsInfo}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    <TextBlock Text="{loc:Tr net.probe_warning}" Style="{StaticResource Muted}" Foreground="{DynamicResource StatusMaybe}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Accent}" Visibility="{Binding Best, Converter={StaticResource NullToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Best}" Style="{StaticResource Body}" FontWeight="SemiBold" AutomationProperties.AutomationId="net.best" />
                                    <TextBlock Text="{loc:Tr net.best_disclaimer}" Style="{StaticResource Muted}" />
                                    <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,2,0,0" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="4">
                                <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding View}" IsReadOnly="False" FrozenColumnCount="3" AutomationProperties.AutomationId="net.grid">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="34" />
                                        <DataGridTemplateColumn Width="32" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><c:FlagIcon Code="{Binding Country}" ToolTip="{Binding Country}" VerticalAlignment="Center" HorizontalAlignment="Center" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Tr net.col.city}" Binding="{Binding City}" IsReadOnly="True" Width="*" MinWidth="150" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.region}" Binding="{Binding Code}" IsReadOnly="True" Width="Auto" MinWidth="104" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.type}" Binding="{Binding EndpointType}" IsReadOnly="True" Width="Auto" MinWidth="110" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.ip}" Binding="{Binding Ip}" IsReadOnly="True" Width="Auto" MinWidth="92" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.protocol}" Binding="{Binding Protocol}" IsReadOnly="True" Width="Auto" MinWidth="66" />
                                        <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat=0.#, TargetNullValue=—}" IsReadOnly="True" Width="48" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.avg}" Binding="{Binding Average, StringFormat=0.#, TargetNullValue=—}" IsReadOnly="True" Width="48" />
                                        <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat=0.#, TargetNullValue=—}" IsReadOnly="True" Width="48" />
                                        <DataGridTextColumn Header="Jitter" Binding="{Binding Jitter, StringFormat=0.#, TargetNullValue=—}" IsReadOnly="True" Width="48" />
                                        <DataGridTemplateColumn Header="{loc:Tr net.col.status}" IsReadOnly="True" Width="Auto" MinWidth="100" SortMemberPath="Quality">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding QualityText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding Note}"
                                                               Foreground="{Binding Quality, Converter={StaticResource StatusBrush}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Tr net.col.last}" Binding="{Binding LastTested}" IsReadOnly="True" Width="Auto" MinWidth="76" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.confidence}" Binding="{Binding ConfidenceText}" IsReadOnly="True" Width="Auto" MinWidth="76" />
                                        <DataGridTemplateColumn IsReadOnly="True" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Copy24}" MinHeight="24" Padding="4,1" ToolTip="{loc:Tr net.copy_ip}" AutomationProperties.AutomationId="net.copy"
                                                               Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <c:ResponsiveGrid MinItemWidth="300" MaxColumns="2">
                                <Border Style="{StaticResource GridCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr net.chart_avg}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <c:BarChart Items="{Binding AverageBars}" Fill="{DynamicResource Accent}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GridCard}" ToolTip="{loc:Tr net.jitter_formula}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr net.chart_jitter}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <c:BarChart Items="{Binding JitterBars}" Fill="{DynamicResource AccentAlt}" />
                                    </StackPanel>
                                </Border>
                            </c:ResponsiveGrid>

                            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr net.thresholds}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                    <WrapPanel>
                                        <ui:TextBox Text="{Binding ExcellentText}" Width="64" Margin="0,0,6,4" ToolTip="{loc:Tr quality.Excellent}" AutomationProperties.AutomationId="net.th1" />
                                        <ui:TextBox Text="{Binding GoodText}" Width="64" Margin="0,0,6,4" ToolTip="{loc:Tr quality.Good}" AutomationProperties.AutomationId="net.th2" />
                                        <ui:TextBox Text="{Binding FairText}" Width="64" Margin="0,0,6,4" ToolTip="{loc:Tr quality.Fair}" AutomationProperties.AutomationId="net.th3" />
                                        <ui:Button Content="{loc:Tr net.save_thresholds}" Command="{Binding SaveThresholdsCommand}" AutomationProperties.AutomationId="net.save_thresholds" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Tr net.tab.live}" AutomationProperties.AutomationId="tab.live">
                    <ScrollViewer Style="{StaticResource PageScroll}">
                        <StackPanel Margin="0,8,8,8">
                            <WrapPanel Margin="0,0,0,8">
                                <ComboBox ItemsSource="{Binding Live.Targets}" SelectedItem="{Binding Live.Selected}" MinWidth="280" Margin="0,0,8,6" AutomationProperties.AutomationId="live.target" />
                                <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr ui.start}" Command="{Binding StartLiveCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="live.start" />
                                <ui:Button Content="{loc:Tr ui.stop}" Command="{Binding StopLiveCommand}" IsEnabled="{Binding IsLive}" Margin="0,0,6,6" AutomationProperties.AutomationId="live.stop" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Live.Summary}" Style="{StaticResource Body}" Margin="0,0,0,8" AutomationProperties.AutomationId="live.summary" />
                            <Border Style="{StaticResource Card}">
                                <c:LineChart Values="{Binding Live.Values}" Height="180" Stroke="{DynamicResource Accent}" />
                            </Border>
                            <TextBlock Text="{loc:Tr net.live_note}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Tr net.tab.route}" AutomationProperties.AutomationId="tab.route">
                    <ScrollViewer Style="{StaticResource PageScroll}">
                        <StackPanel Margin="0,8,8,8">
                            <WrapPanel Margin="0,0,0,8">
                                <ComboBox ItemsSource="{Binding Rows}" DisplayMemberPath="City" SelectedValue="{Binding RouteTarget}" SelectedValuePath="Ip" MinWidth="220" Margin="0,0,8,6" AutomationProperties.AutomationId="route.region" />
                                <ui:TextBox Text="{Binding RouteTarget, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="IP / host" MinWidth="200" Margin="0,0,8,6" AutomationProperties.AutomationId="route.target" />
                                <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr ui.start}" Command="{Binding StartTraceCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="route.start" />
                                <ui:Button Content="{loc:Tr ui.stop}" Command="{Binding StopTraceCommand}" IsEnabled="{Binding IsTracing}" Margin="0,0,6,6" AutomationProperties.AutomationId="route.stop" />
                            </WrapPanel>
                            <TextBlock Text="{Binding RouteError}" Style="{StaticResource Body}" Foreground="{DynamicResource StatusBad}" AutomationProperties.AutomationId="route.error" />
                            <ItemsControl ItemsSource="{Binding RouteNotes}" Margin="0,0,0,6" AutomationProperties.AutomationId="route.notes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,0,0,2" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Card}" Padding="4">
                                <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding Hops}" AutomationProperties.AutomationId="route.grid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="34" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.ip}" Binding="{Binding Address}" Width="Auto" MinWidth="110" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.host}" Binding="{Binding Host}" Width="*" MinWidth="150" />
                                        <DataGridTextColumn Header="RTT" Binding="{Binding Rtts}" Width="Auto" MinWidth="130" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.status}" Binding="{Binding State}" Width="Auto" MinWidth="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <TextBlock Text="{loc:Tr net.route_note}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Tr net.tab.endpoints}" AutomationProperties.AutomationId="tab.endpoints">
                    <ScrollViewer Style="{StaticResource PageScroll}">
                        <StackPanel Margin="0,8,8,8">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <c:ResponsiveGrid MinItemWidth="190" MaxColumns="4">
                                        <StackPanel><TextBlock Text="{loc:Tr net.ep.name}" Style="{StaticResource Muted}" /><ui:TextBox Text="{Binding EpName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ep.name" /></StackPanel>
                                        <StackPanel><TextBlock Text="{loc:Tr net.ep.host}" Style="{StaticResource Muted}" /><ui:TextBox Text="{Binding EpHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ep.host" /></StackPanel>
                                        <StackPanel><TextBlock Text="{loc:Tr net.ep.port}" Style="{StaticResource Muted}" /><ui:TextBox Text="{Binding EpPort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ep.port" /></StackPanel>
                                        <StackPanel><TextBlock Text="{loc:Tr net.protocol}" Style="{StaticResource Muted}" /><ComboBox ItemsSource="{Binding EndpointProtocols}" SelectedIndex="{Binding EpProtocolIndex}" AutomationProperties.AutomationId="ep.protocol" /></StackPanel>
                                        <StackPanel><TextBlock Text="{loc:Tr net.col.region}" Style="{StaticResource Muted}" /><ComboBox ItemsSource="{Binding RegionCodes}" SelectedItem="{Binding EpRegion}" AutomationProperties.AutomationId="ep.region" /></StackPanel>
                                        <StackPanel><TextBlock Text="{loc:Tr net.ep.category}" Style="{StaticResource Muted}" /><ComboBox ItemsSource="{Binding CategoryNames}" SelectedIndex="{Binding EpCategoryIndex}" AutomationProperties.AutomationId="ep.category" /></StackPanel>
                                        <StackPanel><TextBlock Text="{loc:Tr net.ep.provider}" Style="{StaticResource Muted}" /><ui:TextBox Text="{Binding EpProvider, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ep.provider" /></StackPanel>
                                        <StackPanel><TextBlock Text="{loc:Tr net.ep.source}" Style="{StaticResource Muted}" /><ui:TextBox Text="{Binding EpSource, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ep.source" /></StackPanel>
                                        <StackPanel><TextBlock Text="{loc:Tr net.ep.description}" Style="{StaticResource Muted}" /><ui:TextBox Text="{Binding EpDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ep.description" /></StackPanel>
                                        <StackPanel><TextBlock Text="{loc:Tr net.ep.evidence}" Style="{StaticResource Muted}" /><ui:TextBox Text="{Binding EpEvidence, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ep.evidence" /></StackPanel>
                                    </c:ResponsiveGrid>
                                    <CheckBox IsChecked="{Binding EpVerified}" Content="{loc:Tr net.ep.verified}" Margin="0,6,0,6" AutomationProperties.AutomationId="ep.verified" />
                                    <WrapPanel>
                                        <ui:Button Content="{loc:Tr net.ep.new}" Command="{Binding NewEndpointCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="ep.new" />
                                        <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr net.ep.save}" Command="{Binding SaveEndpointCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="ep.save" />
                                        <ui:Button Content="{loc:Tr net.ep.test}" Command="{Binding TestEndpointCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="ep.test" />
                                        <ui:Button Style="{StaticResource DangerButton}" Content="{loc:Tr ui.delete}" Command="{Binding DeleteEndpointCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="ep.delete" />
                                        <ui:Button Content="{loc:Tr ui.import}" Command="{Binding ImportEndpointsCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="ep.import" />
                                        <ui:Button Content="{loc:Tr ui.export}" Command="{Binding ExportEndpointsCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="ep.export" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding EpMessage}" Style="{StaticResource Body}" AutomationProperties.AutomationId="ep.message" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="4">
                                <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding Endpoints}" SelectedItem="{Binding SelectedEndpoint}" AutomationProperties.AutomationId="ep.grid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr net.ep.name}" Binding="{Binding Name}" Width="*" MinWidth="130" />
                                        <DataGridTextColumn Header="{loc:Tr net.ep.host}" Binding="{Binding Host}" Width="Auto" MinWidth="110" />
                                        <DataGridTextColumn Header="{loc:Tr net.ep.port}" Binding="{Binding Port}" Width="60" />
                                        <DataGridTextColumn Header="{loc:Tr net.ep.category}" Binding="{Binding Category}" Width="Auto" MinWidth="120" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.region}" Binding="{Binding Region}" Width="Auto" MinWidth="100" />
                                        <DataGridCheckBoxColumn Header="{loc:Tr net.ep.verified}" Binding="{Binding Verified}" Width="Auto" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.last}" Binding="{Binding LastSuccess, StringFormat=g}" Width="Auto" MinWidth="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Tr net.tab.active}" AutomationProperties.AutomationId="tab.active">
                    <ScrollViewer Style="{StaticResource PageScroll}">
                        <StackPanel Margin="0,8,8,8">
                            <Border Style="{StaticResource Card}">
                                <TextBlock Text="{loc:Tr net.active_note}" Style="{StaticResource Body}" />
                            </Border>
                            <WrapPanel Margin="0,0,0,8">
                                <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr net.observe}" Command="{Binding ObserveCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="active.observe" />
                                <ui:Button Content="{loc:Tr net.save_possible}" Command="{Binding SaveObservedCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="active.save" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ActiveStatus}" Style="{StaticResource Body}" Margin="0,0,0,8" AutomationProperties.AutomationId="active.status" />
                            <Border Style="{StaticResource Card}" Padding="4">
                                <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding Observed}" SelectedItem="{Binding SelectedObserved}" AutomationProperties.AutomationId="active.grid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr net.col.ip}" Binding="{Binding Ip}" Width="*" MinWidth="110" />
                                        <DataGridTextColumn Header="{loc:Tr net.ep.port}" Binding="{Binding Port}" Width="60" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.protocol}" Binding="{Binding Protocol}" Width="60" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.status}" Binding="{Binding State}" Width="Auto" MinWidth="90" />
                                        <DataGridTextColumn Header="{loc:Tr net.ep.provider}" Binding="{Binding Provider}" Width="Auto" MinWidth="80" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.region}" Binding="{Binding Region}" Width="Auto" MinWidth="100" />
                                        <DataGridTextColumn Header="{loc:Tr net.ep.category}" Binding="{Binding Classification}" Width="Auto" MinWidth="130" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Tr net.tab.history}" AutomationProperties.AutomationId="tab.history">
                    <ScrollViewer Style="{StaticResource PageScroll}">
                        <StackPanel Margin="0,8,8,8">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr net.ingame_title}" Style="{StaticResource Section}" Margin="0,0,0,4" />
                                    <TextBlock Text="{loc:Tr net.ingame_guide}" Style="{StaticResource Body}" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <ui:TextBox Text="{Binding ManualPingText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ms" Width="90" Margin="0,0,6,6" AutomationProperties.AutomationId="hist.manual" />
                                        <ui:Button Content="{loc:Tr net.manual_save}" Command="{Binding SaveManualPingCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="hist.manual_save" />
                                        <ui:Button Content="{loc:Tr net.ea_help}" Command="{Binding OpenEaHelpCommand}" Margin="0,0,6,6" AutomationProperties.AutomationId="hist.ea_help" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ManualMessage}" Style="{StaticResource Muted}" AutomationProperties.AutomationId="hist.message" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding RegionCodes}" SelectedItem="{Binding HistoryRegion}" MinWidth="200" HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.AutomationId="hist.region" />
                                    <c:LineChart Values="{Binding HistoryValues}" Height="110" Stroke="{DynamicResource AccentAlt}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="4">
                                <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding History}" AutomationProperties.AutomationId="hist.grid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr net.col.last}" Binding="{Binding Time}" Width="Auto" MinWidth="110" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.region}" Binding="{Binding Region}" Width="*" MinWidth="110" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.protocol}" Binding="{Binding Protocol}" Width="60" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.avg}" Binding="{Binding Average}" Width="70" />
                                        <DataGridTextColumn Header="Jitter" Binding="{Binding Jitter}" Width="70" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.replies}" Binding="{Binding Replies}" Width="60" />
                                        <DataGridTextColumn Header="{loc:Tr net.col.source}" Binding="{Binding Source}" Width="*" MinWidth="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
