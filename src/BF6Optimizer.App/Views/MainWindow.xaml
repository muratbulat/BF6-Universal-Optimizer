<ui:FluentWindow x:Class="BF6Optimizer.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:BF6Optimizer.App.Localization"
                 Title="BF6 Universal Optimizer" MinWidth="760" MinHeight="460"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI" AutomationProperties.AutomationId="mainWindow"
                 Background="{DynamicResource AppBackground}"
                 SourceInitialized="OnSourceInitialized" Loaded="OnLoaded" SizeChanged="OnSizeChanged" Closing="OnClosing">
    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="BF6 Universal Optimizer" Grid.Row="0" Height="32" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="{Binding SidebarWidth}" Background="{DynamicResource SidebarBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ToggleSidebarCommand}" Margin="8,4,8,2" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="nav.toggle" AutomationProperties.Name="Menu" ToolTip="{loc:Tr ui.toggle_menu}">
                        <ui:SymbolIcon Symbol="Navigation24" FontSize="16" Foreground="{DynamicResource TextMuted}" />
                    </Button>
                    <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="8,0,8,8" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,2">
                                        <Button Style="{StaticResource NavButton}" Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch"
                                                Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotBoolToVis}}"
                                                AutomationProperties.AutomationId="{Binding Id}" AutomationProperties.Name="{Binding Title}">
                                            <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource NavButton}" HorizontalAlignment="Stretch" ToolTip="{Binding Title}"
                                                            AutomationProperties.AutomationId="{Binding TitleKey}" AutomationProperties.Name="{Binding Title}"
                                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Foreground="{DynamicResource Accent}" />
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="9,0,0,0" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                                       Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotBoolToVis}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Status bar -->
                <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="16,4,8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding HeaderText}" AutomationProperties.AutomationId="header.status" />
                        <ui:Button Grid.Column="1" Appearance="Transparent" Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettingsCommand}" MinHeight="26" Padding="6,2"
                                   ToolTip="{loc:Tr nav.settings}" AutomationProperties.AutomationId="header.settings" AutomationProperties.Name="Settings" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="16,4,16,0">
                    <TextBlock Text="{Binding StorageNote}" Foreground="{DynamicResource StatusMaybe}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding StorageNote, Converter={StaticResource NullToVis}}" />
                    <StackPanel Visibility="{Binding State.IsScanning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding State.ScanStage}" Style="{StaticResource Muted}" />
                        <ProgressBar Value="{Binding State.ScanPercent}" Maximum="100" Height="3" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Background="{DynamicResource StatusMaybe}" CornerRadius="4" Padding="8,3" Margin="0,4,0,0"
                            Visibility="{Binding State.Hardware.IsSimulated, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{loc:Tr ui.simulated_banner}" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                </StackPanel>

                <ContentControl Grid.Row="2" Content="{Binding Current}" Focusable="False" AutomationProperties.AutomationId="page.host"
                                Visibility="{Binding IsLoading, Converter={StaticResource NotBoolToVis}}" />
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing IsIndeterminate="True" />
                    <TextBlock Text="{loc:Tr ui.detecting}" Style="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Toast -->
                <Border Grid.Row="2" Style="{StaticResource GridCard}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" MaxWidth="460"
                        BorderBrush="{DynamicResource Accent}" Visibility="{Binding State.Toast, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding State.Toast}" Style="{StaticResource Body}" AutomationProperties.AutomationId="toast" />
                </Border>
            </Grid>
        </Grid>

        <!-- First-run welcome -->
        <Grid Grid.RowSpan="2" Background="{DynamicResource OverlayScrim}" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource GridCard}" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="{loc:Tr welcome.title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Tr welcome.body}" Style="{StaticResource Body}" Margin="0,8,0,8" />
                    <TextBlock Text="{loc:Tr welcome.safety}" Style="{StaticResource Muted}" Margin="0,0,0,16" />
                    <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr welcome.start}" Command="{Binding CompleteWelcomeCommand}" HorizontalAlignment="Right"
                               AutomationProperties.AutomationId="welcome.start" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
